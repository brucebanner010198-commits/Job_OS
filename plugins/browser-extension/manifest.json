{
  "manifest_version": 3,
  "name": "Job OS Companion Autofill",
  "version": "1.0.0",
  "description": "One-click autofill for job applications powered by your local Job OS.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost:3000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job OS Autofill"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.greenhouse.io/*",
        "*://boards.greenhouse.io/*",
        "*://jobs.lever.co/*",
        "*://*.ashbyhq.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.linkedin.com/jobs/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
